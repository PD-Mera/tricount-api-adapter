# Optional. Leave empty to list tricounts associated with the generated device.
# Set one or more comma-separated share tokens to fetch shared tricounts.
TRICOUNT_SHARE_TOKENS=
# Backward-compatible single-token setting:
TRICOUNT_SHARE_TOKEN=

# Defaults are included for reference; Compose uses them when these are omitted.
TRICOUNT_BASE_URL=https://api.tricount.bunq.com
TRICOUNT_USER_AGENT=com.bunq.tricount.android:RELEASE:7.0.7:3174:ANDROID:13:C
TRICOUNT_CLIENT_REQUEST_ID=049bfcdf-6ae4-4cee-af7b-45da31ea85d0
